<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Molaway</AssemblyName>
    <Version>0.1.0</Version><InformationalVersion>0.1.0-preview.1</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Molaway.ico</ApplicationIcon>
    <StartupObject>Molaway.Windows.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Molaway.Core/Molaway.Core.csproj"/>
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../../UPSTREAM.md" Link="UPSTREAM.md" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../README.md" Link="WINDOWS-README.md" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
